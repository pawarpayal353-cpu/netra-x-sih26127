# Copy this file to .env and adjust as needed.
# The app runs with zero configuration using the SQLite defaults below.

# SQLite (default, zero-config demo mode):
DATABASE_URL=sqlite:///./netrax.db

# PostgreSQL / PostGIS (production):
# DATABASE_URL=postgresql+psycopg2://netrax:netrax@localhost:5432/netrax

ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
